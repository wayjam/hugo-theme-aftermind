{{- .EnableAllLanguages -}}
{{- $config := .Site.Params.search | default dict -}}
{{- $provider := lower ($config.provider | default "json") -}}
{{- if in (slice "json" "pagefind") $provider -}}
  {{- .AddPage (dict
    "path" "."
    "kind" "page"
    "title" (i18n "search_title" | default "Search")
    "layout" "aftermind-search"
    "outputs" (slice "html")
    "build" (dict "list" "never" "render" "always")
    "params" (dict "aftermindSearchPage" true)
  ) -}}
{{- else if ne $provider "none" -}}
  {{- errorf "Aftermind search: set params.search.provider to json, pagefind, or none (got %q)" $provider -}}
{{- end -}}
